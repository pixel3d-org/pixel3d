---
source: apps/pixel3d-cli/tests/mcp_stdio.rs
expression: tools
---
{
  "id": 2,
  "jsonrpc": "2.0",
  "result": {
    "tools": [
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "description": "What is in the scene: parts with sizes and positions, contacts, problems and test results, in a few lines.",
        "inputSchema": {
          "$defs": {
            "Detail": {
              "description": "How much `scene_overview` says.",
              "oneOf": [
                {
                  "const": "brief",
                  "description": "Parts, sizes, contacts, problems and tests in a few lines.",
                  "type": "string"
                },
                {
                  "const": "full",
                  "description": "Adds groups, tags and every relation.",
                  "type": "string"
                }
              ]
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "detail": {
              "$ref": "#/$defs/Detail",
              "default": "brief",
              "description": "`brief` (default) or `full`."
            }
          },
          "title": "SceneOverviewArgs",
          "type": "object"
        },
        "name": "scene_overview"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "description": "One-screen summary of an object: size, origin, parts, shape, symmetry, topology, groups, problems.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "target": {
              "description": "Object (name, path such as `crate/lid`, or id such as `o:3`).",
              "type": "string"
            }
          },
          "required": [
            "target"
          ],
          "title": "DescribeArgs",
          "type": "object"
        },
        "name": "describe"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": false
        },
        "description": "Run ops as one undoable transaction (all or nothing); returns per-op results, created groups, warnings, test results.",
        "inputSchema": {
          "$defs": {
            "RunOp": {
              "additionalProperties": false,
              "description": "One op call of a `run` batch.",
              "properties": {
                "args": {
                  "default": null,
                  "description": "Op parameters (`describe_op` shows the schema); omitted means defaults."
                },
                "label": {
                  "description": "Label for the history and for created groups (`<label>.<role>`).",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "op": {
                  "description": "Op id, for example `prim.box` (`list_ops` shows them all).",
                  "type": "string"
                }
              },
              "required": [
                "op"
              ],
              "type": "object"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "checkpoint": {
              "description": "Name the resulting state (for `history revert` and `history diff`).",
              "type": [
                "string",
                "null"
              ]
            },
            "dry_run": {
              "default": false,
              "description": "Report what would happen, then discard it.",
              "type": "boolean"
            },
            "label": {
              "description": "Undo label; the op labels when omitted.",
              "type": [
                "string",
                "null"
              ]
            },
            "ops": {
              "description": "Ops applied in order as one transaction: all succeed or nothing changes.",
              "items": {
                "$ref": "#/$defs/RunOp"
              },
              "type": "array"
            }
          },
          "required": [
            "ops"
          ],
          "title": "RunArgs",
          "type": "object"
        },
        "name": "run"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "description": "Understand the model without images: structure, shape, silhouette, section, relations, probe, diff, visibility, proportions, brief or dna, as compact text.",
        "inputSchema": {
          "$defs": {
            "Aspect": {
              "oneOf": [
                {
                  "const": "structure",
                  "description": "What is where: parts, sizes, positions, groups, contacts, mirror pairs.",
                  "type": "string"
                },
                {
                  "const": "shape",
                  "description": "Per part: best-fit primitive, axes, volume, thickness, edges, symmetry.",
                  "type": "string"
                },
                {
                  "const": "silhouette",
                  "description": "Outline from a view as a short polyline labelled by part.",
                  "type": "string"
                },
                {
                  "const": "section",
                  "description": "Loops of a planar slice, with wall thickness.",
                  "type": "string"
                },
                {
                  "const": "relations",
                  "description": "Contacts, gaps, penetrations, floating parts.",
                  "type": "string"
                },
                {
                  "const": "probe",
                  "description": "Everything at one surface point (needs `at`).",
                  "type": "string"
                },
                {
                  "const": "diff",
                  "description": "What changed since `from` (a revision or checkpoint; the previous revision by default).",
                  "type": "string"
                },
                {
                  "const": "visibility",
                  "description": "How it reads at the asset class view distance: pixel sizes, details for normal maps, hidden surface, triangles against screen share.",
                  "type": "string"
                },
                {
                  "const": "proportions",
                  "description": "A spec root's ratios against its category and style ranges, and part sizes relative to the main part.",
                  "type": "string"
                },
                {
                  "const": "brief",
                  "description": "Coverage of the brief the target's spec answers (or the only brief).",
                  "type": "string"
                },
                {
                  "const": "dna",
                  "description": "Visual DNA: form genes measured against the spec's `dna` (or `dna` given here) and the art-direction critique.",
                  "type": "string"
                }
              ]
            },
            "DnaSpec": {
              "additionalProperties": false,
              "description": "The genes as written (a spec's or brief's `dna` block).",
              "properties": {
                "archetype": {
                  "description": "The archetype whose proportion ranges and gesture apply (`dwarf`,\n`sword`, ...); archetype instances in a spec set it.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "culture": {
                  "description": "`dwarven`, `elven`, `orcish` or `human_medieval`.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "edges": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/EdgesGene"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "gesture": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/GestureGene"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Centerline bend of elongated parts."
                },
                "hierarchy": {
                  "description": "Primary, secondary and tertiary volume shares, for example `[0.6, 0.3, 0.1]`.",
                  "items": {
                    "format": "float",
                    "type": "number"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "lines": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/LinesGene"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "proportions": {
                  "additionalProperties": {
                    "items": {
                      "format": "float",
                      "type": "number"
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                  },
                  "description": "Ratios: `{\"blade_to_haft\": [0.3, 0.45]}` (part heights), or the\nhumanoid measures `heads`, `shoulders` (head heights) and `legs`\n(crotch height over height).",
                  "type": "object"
                },
                "rest": {
                  "description": "Share of the model's length free of small detail (rest areas).",
                  "items": {
                    "format": "float",
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "rhythm": {
                  "description": "`varied` (repeated parts must vary) or `regular`.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "silhouette": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/SilhouetteGene"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "style": {
                  "description": "`realistic` or `stylized_painterly`.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "surface": {
                  "description": "Surface genes (wear, damage, ornament), built in Phase 6."
                },
                "variation": {
                  "description": "Seed, asymmetry and variants."
                }
              },
              "type": "object"
            },
            "EdgesGene": {
              "anyOf": [
                {
                  "description": "`varied`, `uniform`, `sharp` or `soft`.",
                  "type": "string"
                },
                {
                  "description": "Coefficient of variation of bevel widths.",
                  "properties": {
                    "bevel_variation": {
                      "items": {
                        "format": "float",
                        "type": "number"
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": "array"
                    }
                  },
                  "required": [
                    "bevel_variation"
                  ],
                  "type": "object"
                }
              ],
              "description": "The `edges` gene."
            },
            "GestureGene": {
              "additionalProperties": false,
              "description": "The `gesture` gene: how much elongated parts' centerlines bend.",
              "properties": {
                "bend": {
                  "description": "The bend: the centerline's largest distance from its chord over the\npart's length (0.02 a hint of a curve, 0.1 a sabre).",
                  "items": {
                    "format": "float",
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array"
                },
                "parts": {
                  "description": "Parts that should bend; every elongated part when empty.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "bend"
              ],
              "type": "object"
            },
            "Length": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*(mm|cm|dm|m|km|in|ft)?\\s*$",
                  "type": "string"
                }
              ],
              "description": "Length: meters as a number, or a string with a unit (mm, cm, dm, m, km, in, ft), e.g. \"30cm\"."
            },
            "LinesGene": {
              "anyOf": [
                {
                  "description": "`angular`, `flowing`, `heavy` or `balanced`.",
                  "type": "string"
                },
                {
                  "properties": {
                    "curved": {
                      "default": null,
                      "items": {
                        "format": "float",
                        "type": "number"
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "taper": {
                      "default": null,
                      "items": {
                        "format": "float",
                        "type": "number"
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": [
                        "array",
                        "null"
                      ]
                    }
                  },
                  "type": "object"
                }
              ],
              "description": "The `lines` gene: a preset word or explicit ranges."
            },
            "RayFrom": {
              "additionalProperties": false,
              "description": "A ray cast at a part from one side.",
              "properties": {
                "at": {
                  "description": "The other two world coordinates of the ray in meters, in x, y, z order\n(for `+x`: [y, z]); the part's center when omitted.",
                  "items": {
                    "format": "float",
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "from": {
                  "description": "Side the ray comes from: `+x`, `-x`, `+y`, `-y`, `+z` or `-z`.",
                  "type": "string"
                }
              },
              "required": [
                "from"
              ],
              "type": "object"
            },
            "SilhouetteGene": {
              "additionalProperties": false,
              "description": "The `silhouette` gene.",
              "properties": {
                "solidity": {
                  "default": null,
                  "description": "Filled share of the outline's convex hull, front and side.",
                  "items": {
                    "format": "float",
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": [
                    "array",
                    "null"
                  ]
                }
              },
              "type": "object"
            },
            "SliceAxis": {
              "description": "Slice plane normal.",
              "oneOf": [
                {
                  "const": "x",
                  "description": "A vertical slice across X; loops in (z, y).",
                  "type": "string"
                },
                {
                  "const": "y",
                  "description": "A horizontal slice; loops in (x, z).",
                  "type": "string"
                },
                {
                  "const": "z",
                  "description": "A vertical slice across Z; loops in (x, y).",
                  "type": "string"
                }
              ]
            },
            "SurfacePoint": {
              "additionalProperties": false,
              "description": "A point on a part's surface, addressed by meaning (project spec 17.8).\nGive exactly one of `landmark`, `nearest`, `ray` or `group`; the\n`center` landmark when none is given.",
              "properties": {
                "group": {
                  "description": "The surface point nearest the area center of a face group.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "landmark": {
                  "description": "`top`, `bottom`, `front` (+Z), `back`, `left` (-X), `right`, or\n`center`: where a ray through the part's box center toward that side\nleaves the part (`center`: the surface point nearest the box center).",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "nearest": {
                  "description": "The surface point nearest to this world position (meters).",
                  "items": {
                    "format": "float",
                    "type": "number"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "on": {
                  "description": "Part (name, path or id).",
                  "type": "string"
                },
                "ray": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/RayFrom"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The first hit of a ray from one side."
                }
              },
              "required": [
                "on"
              ],
              "type": "object"
            },
            "ViewDir": {
              "description": "Where the orthographic camera sits.",
              "oneOf": [
                {
                  "const": "front",
                  "description": "From +Z (the asset's front): outline in (x, y).",
                  "type": "string"
                },
                {
                  "const": "back",
                  "description": "From -Z: outline in (x, y).",
                  "type": "string"
                },
                {
                  "const": "right",
                  "description": "From +X (the asset's right side): outline in (z, y).",
                  "type": "string"
                },
                {
                  "const": "left",
                  "description": "From -X: outline in (z, y).",
                  "type": "string"
                },
                {
                  "const": "top",
                  "description": "From +Y: outline in (x, z).",
                  "type": "string"
                },
                {
                  "const": "bottom",
                  "description": "From -Y: outline in (x, z).",
                  "type": "string"
                }
              ]
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "aspect": {
              "$ref": "#/$defs/Aspect",
              "default": "structure",
              "description": "What to perceive."
            },
            "at": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Length"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`section`: plane position; the middle of the target when omitted."
            },
            "axis": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SliceAxis"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`section`: slice across x, y (default, horizontal) or z."
            },
            "dna": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DnaSpec"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`dna`: genes to measure against, for example `{\"culture\": \"dwarven\"}` (the target spec's own when omitted)."
            },
            "from": {
              "description": "`diff`: base revision number or checkpoint name.",
              "type": [
                "string",
                "null"
              ]
            },
            "point": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SurfacePoint"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`probe`: the surface point, e.g. `{\"on\": \"crate\", \"landmark\": \"top\"}`."
            },
            "points": {
              "description": "`silhouette` and `section`: outline points (default 32 and 48).",
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "target": {
              "description": "Object to look at with its children; the whole scene when omitted.",
              "type": [
                "string",
                "null"
              ]
            },
            "view": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ViewDir"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`silhouette`: front (default), back, left, right, top, bottom."
            }
          },
          "title": "PerceiveArgs",
          "type": "object"
        },
        "name": "perceive"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": false
        },
        "description": "Problems like compiler errors (part, place, cause) with fixes and their predicted results; explain or apply a fix.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "explain": {
              "description": "Finding id (`F3`) to explain: every fix option with its predicted result.",
              "type": [
                "string",
                "null"
              ]
            },
            "fix": {
              "description": "Finding id (`F3`) to fix now (one undoable step).",
              "type": [
                "string",
                "null"
              ]
            },
            "option": {
              "description": "Fix option for `fix` (0 is the first).",
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "target": {
              "description": "Object to check with its children; the whole scene when omitted.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "title": "DiagnoseArgs",
          "type": "object"
        },
        "name": "diagnose"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": false
        },
        "description": "Tests for the model (dims, symmetric, attached, not_intersecting, budget, watertight): add, remove, list, check.",
        "inputSchema": {
          "$defs": {
            "ExpectAction": {
              "oneOf": [
                {
                  "enum": [
                    "list",
                    "add",
                    "remove"
                  ],
                  "type": "string"
                },
                {
                  "const": "check",
                  "description": "Run every expectation.",
                  "type": "string"
                }
              ]
            },
            "ExpectArgs": {
              "description": "What to test.",
              "oneOf": [
                {
                  "additionalProperties": false,
                  "description": "World size of an object together with its children.",
                  "properties": {
                    "dims": {
                      "additionalProperties": false,
                      "properties": {
                        "depth": {
                          "anyOf": [
                            {
                              "$ref": "#/$defs/LengthRange"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Size along Z."
                        },
                        "height": {
                          "anyOf": [
                            {
                              "$ref": "#/$defs/LengthRange"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Size along Y."
                        },
                        "target": {
                          "description": "Object (name, path or id).",
                          "type": "string"
                        },
                        "width": {
                          "anyOf": [
                            {
                              "$ref": "#/$defs/LengthRange"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Size along X."
                        }
                      },
                      "required": [
                        "target"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "dims"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "`a` and `b` are mirror images across the world plane `axis = at`;\nwithout `b`, `a` (with its children) mirrors itself across its\ncenter plane.",
                  "properties": {
                    "symmetric": {
                      "additionalProperties": false,
                      "properties": {
                        "a": {
                          "description": "First object.",
                          "type": "string"
                        },
                        "at": {
                          "anyOf": [
                            {
                              "$ref": "#/$defs/Length"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Plane position; 0 for pairs, the center for a single object."
                        },
                        "axis": {
                          "$ref": "#/$defs/MirrorAxis",
                          "default": "x",
                          "description": "Mirror axis (default x: left-right)."
                        },
                        "b": {
                          "description": "Its mirror partner.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "tolerance": {
                          "anyOf": [
                            {
                              "$ref": "#/$defs/Length"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Largest allowed deviation (default 1 mm)."
                        }
                      },
                      "required": [
                        "a"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "symmetric"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "`part` touches `to`.",
                  "properties": {
                    "attached": {
                      "additionalProperties": false,
                      "properties": {
                        "max_gap": {
                          "anyOf": [
                            {
                              "$ref": "#/$defs/Length"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Largest allowed gap (default 1 mm)."
                        },
                        "max_penetration": {
                          "anyOf": [
                            {
                              "$ref": "#/$defs/Length"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Deepest it may sink in (no limit by default)."
                        },
                        "part": {
                          "description": "The attached object.",
                          "type": "string"
                        },
                        "to": {
                          "description": "What it attaches to.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "part",
                        "to"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "attached"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "No two of the objects pass through or sit inside each other.",
                  "properties": {
                    "not_intersecting": {
                      "additionalProperties": false,
                      "properties": {
                        "parts": {
                          "description": "2 to 64 objects.",
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "required": [
                        "parts"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "not_intersecting"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "Triangle count of an object with its children, or of the scene.",
                  "properties": {
                    "budget": {
                      "additionalProperties": false,
                      "properties": {
                        "max_tris": {
                          "description": "Upper limit (default: the asset class budget).",
                          "format": "uint64",
                          "minimum": 0,
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "min_tris": {
                          "description": "Lower limit.",
                          "format": "uint64",
                          "minimum": 0,
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "target": {
                          "description": "Object; the whole scene when omitted.",
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "type": "object"
                    }
                  },
                  "required": [
                    "budget"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "The object's meshes are closed and face outward.",
                  "properties": {
                    "watertight": {
                      "additionalProperties": false,
                      "properties": {
                        "target": {
                          "description": "Object (name, path or id).",
                          "type": "string"
                        }
                      },
                      "required": [
                        "target"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "watertight"
                  ],
                  "type": "object"
                }
              ]
            },
            "Length": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*(mm|cm|dm|m|km|in|ft)?\\s*$",
                  "type": "string"
                }
              ],
              "description": "Length: meters as a number, or a string with a unit (mm, cm, dm, m, km, in, ft), e.g. \"30cm\"."
            },
            "LengthRange": {
              "additionalProperties": false,
              "description": "A range of lengths; either end may be left open.",
              "properties": {
                "max": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Length"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "min": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Length"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "type": "object"
            },
            "MirrorAxis": {
              "description": "A mirror axis.",
              "oneOf": [
                {
                  "const": "x",
                  "description": "Left-right (across the YZ plane).",
                  "type": "string"
                },
                {
                  "const": "y",
                  "description": "Up-down.",
                  "type": "string"
                },
                {
                  "const": "z",
                  "description": "Front-back.",
                  "type": "string"
                }
              ]
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "action": {
              "$ref": "#/$defs/ExpectAction",
              "default": "check",
              "description": "`check` (default), `list`, `add` or `remove`."
            },
            "expect": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ExpectArgs"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`add`: the test, e.g. `{\"attached\": {\"part\": \"lid\", \"to\": \"crate\"}}`."
            },
            "name": {
              "description": "`add`: optional name; `remove`: the name.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "title": "ExpectToolArgs",
          "type": "object"
        },
        "name": "expect"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": false
        },
        "description": "Capture what the user asked for (category, style, size, budget, must-haves) as checks, and see how well the model answers it.",
        "inputSchema": {
          "$defs": {
            "BriefAction": {
              "oneOf": [
                {
                  "enum": [
                    "set",
                    "get"
                  ],
                  "type": "string"
                },
                {
                  "const": "coverage",
                  "description": "How well the model answers the brief (default).",
                  "type": "string"
                }
              ]
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "action": {
              "$ref": "#/$defs/BriefAction",
              "default": "coverage",
              "description": "`coverage` (default), `set` or `get`."
            },
            "brief": {
              "description": "`set`: the brief: title, category, style, size, budget, must_have, must_not (see the spec guide)."
            },
            "name": {
              "description": "The brief's name; a spec answers it with `\"brief\": \"<name>\"`.",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "title": "BriefArgs",
          "type": "object"
        },
        "name": "brief"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": false
        },
        "description": "Author the model as a Model Spec (named parts, shapes, anchors at landmarks, joins): set, patch or compile; returns parts, brief coverage, problems and tests.",
        "inputSchema": {
          "$defs": {
            "PatchOp": {
              "additionalProperties": false,
              "description": "One JSON Patch operation.",
              "properties": {
                "from": {
                  "description": "Source pointer of `move` and `copy`.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "op": {
                  "description": "`add`, `remove`, `replace`, `move`, `copy` or `test`.",
                  "type": "string"
                },
                "path": {
                  "description": "JSON pointer into the spec, for example `/parts/ear_l/blend`.",
                  "type": "string"
                },
                "value": true
              },
              "required": [
                "op",
                "path"
              ],
              "type": "object"
            },
            "SpecAction": {
              "oneOf": [
                {
                  "enum": [
                    "set",
                    "patch",
                    "compile"
                  ],
                  "type": "string"
                },
                {
                  "const": "get",
                  "description": "The spec source and its parts (default).",
                  "type": "string"
                }
              ]
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "action": {
              "$ref": "#/$defs/SpecAction",
              "default": "get",
              "description": "`get` (default), `set`, `patch` or `compile`."
            },
            "dry_run": {
              "default": false,
              "description": "Preview the result without changing anything.",
              "type": "boolean"
            },
            "force": {
              "default": false,
              "description": "`compile`: rebuild every part.",
              "type": "boolean"
            },
            "merge": {
              "description": "`patch`: a JSON Merge Patch (`null` removes)."
            },
            "ops": {
              "description": "`patch`: JSON Patch operations instead of a merge patch.",
              "items": {
                "$ref": "#/$defs/PatchOp"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "spec": {
              "description": "`set`: the Model Spec `{\"parts\": {...}}`."
            },
            "target": {
              "description": "The spec's root object (`set` creates it).",
              "type": "string"
            }
          },
          "required": [
            "target"
          ],
          "title": "SpecArgs",
          "type": "object"
        },
        "name": "spec"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": false
        },
        "description": "Sculpt by numbers: move named points (landmarks, shapes, groups) or coordinates by offsets with pins held; spec parts keep the handles across recompiles.",
        "inputSchema": {
          "$defs": {
            "DeformHandleArg": {
              "additionalProperties": false,
              "description": "One handle of the `deform` tool.",
              "properties": {
                "by": {
                  "description": "How far it moves.",
                  "items": {
                    "$ref": "#/$defs/Length"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "move": {
                  "description": "What to grab: a name (a landmark such as `tip` or `top`, an SDF shape or a face group) or coordinates."
                }
              },
              "required": [
                "move",
                "by"
              ],
              "type": "object"
            },
            "Length": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*(mm|cm|dm|m|km|in|ft)?\\s*$",
                  "type": "string"
                }
              ],
              "description": "Length: meters as a number, or a string with a unit (mm, cm, dm, m, km, in, ft), e.g. \"30cm\"."
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "handles": {
              "items": {
                "$ref": "#/$defs/DeformHandleArg"
              },
              "type": "array"
            },
            "pins": {
              "description": "Points that stay put (names or coordinates).",
              "items": true,
              "type": "array"
            },
            "radius": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Length"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Reach along the surface; 40% of the part's diagonal when omitted."
            },
            "replace": {
              "default": false,
              "description": "Spec parts: replace the part's earlier handles instead of adding to them.",
              "type": "boolean"
            },
            "target": {
              "description": "A spec part (`elf_head/ear_l`; kept in the spec, so recompiles keep it) or any mesh object.",
              "type": "string"
            }
          },
          "required": [
            "target",
            "handles"
          ],
          "title": "DeformArgs",
          "type": "object"
        },
        "name": "deform"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": false
        },
        "description": "Feature templates (head bases, hands, ears, eyes, noses, horns, cables, bolts, rivets, vents, panels, moldings) built from semantic parameters: list, search or describe one with its parameters and landmarks.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "feature": {
              "description": "Describe this feature in full (id or alias, for example `ear` or `ram horn`).",
              "type": [
                "string",
                "null"
              ]
            },
            "search": {
              "description": "Words to find in feature ids, labels, aliases and summaries.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "title": "FeaturesArgs",
          "type": "object"
        },
        "name": "features"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": false
        },
        "description": "Count and locate mesh elements picked by a selector (groups, normals, boundaries, boxes); optionally save them as a group.",
        "inputSchema": {
          "$defs": {
            "BoxFilter": {
              "additionalProperties": false,
              "description": "Axis-aligned box for the `in_box` filter, in meters.",
              "properties": {
                "max": {
                  "items": {
                    "format": "float",
                    "type": "number"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "min": {
                  "items": {
                    "format": "float",
                    "type": "number"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                }
              },
              "required": [
                "min",
                "max"
              ],
              "type": "object"
            },
            "Filter": {
              "additionalProperties": false,
              "description": "Conditions on elements; all given conditions must hold.",
              "properties": {
                "boundary": {
                  "description": "On the mesh boundary (true) or not (false). Faces: having a boundary edge.",
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "group": {
                  "description": "Member of this named group (the group must hold this element kind).",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ids": {
                  "description": "Element indices, valid only at the mesh revision they were read at\n(interactive selections in the app; prefer groups and filters).",
                  "items": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "in_box": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/BoxFilter"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Inside an axis-aligned box in object space: vertex positions, edge\nmidpoints, face centroids."
                },
                "material": {
                  "description": "Faces with this material slot.",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "normal": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/NormalFilter"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Facing within an angle of a direction. Faces use the face normal,\nedges the mean of their faces' normals, vertices the mean of their\nfaces' normals."
                },
                "seam": {
                  "description": "Edges marked as UV seams (true) or not (false).",
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "sharp": {
                  "description": "Edges marked sharp (true) or not (false).",
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "sharper_than_deg": {
                  "description": "Edges whose faces meet at more than this angle in degrees (0 is flat).",
                  "format": "float",
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "type": "object"
            },
            "NormalFilter": {
              "additionalProperties": false,
              "description": "Direction and tolerance for the `normal` filter.",
              "properties": {
                "dir": {
                  "description": "Direction in object space (need not be unit length).",
                  "items": {
                    "format": "float",
                    "type": "number"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "within_deg": {
                  "description": "Largest angle from `dir` in degrees.",
                  "format": "float",
                  "type": "number"
                }
              },
              "required": [
                "dir",
                "within_deg"
              ],
              "type": "object"
            },
            "Selector": {
              "description": "A set of mesh elements described by meaning.",
              "oneOf": [
                {
                  "additionalProperties": false,
                  "description": "Faces matching every condition of the filter (all faces when empty).",
                  "properties": {
                    "faces": {
                      "$ref": "#/$defs/Filter"
                    }
                  },
                  "required": [
                    "faces"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "Edges matching every condition of the filter.",
                  "properties": {
                    "edges": {
                      "$ref": "#/$defs/Filter"
                    }
                  },
                  "required": [
                    "edges"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "Vertices matching every condition of the filter.",
                  "properties": {
                    "verts": {
                      "$ref": "#/$defs/Filter"
                    }
                  },
                  "required": [
                    "verts"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "Elements in every selector (all of the same kind).",
                  "properties": {
                    "and": {
                      "items": {
                        "$ref": "#/$defs/Selector"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "and"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "Elements in any selector (all of the same kind).",
                  "properties": {
                    "or": {
                      "items": {
                        "$ref": "#/$defs/Selector"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "or"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "Elements of the same kind not in the selector.",
                  "properties": {
                    "not": {
                      "$ref": "#/$defs/Selector"
                    }
                  },
                  "required": [
                    "not"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "Adds neighbours `steps` times: faces across edges, edges and vertices\nthrough shared vertices.",
                  "properties": {
                    "grow": {
                      "additionalProperties": false,
                      "properties": {
                        "of": {
                          "$ref": "#/$defs/Selector"
                        },
                        "steps": {
                          "format": "uint32",
                          "minimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "steps",
                        "of"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "grow"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "Removes the outermost elements `steps` times (the inverse of grow).",
                  "properties": {
                    "shrink": {
                      "additionalProperties": false,
                      "properties": {
                        "of": {
                          "$ref": "#/$defs/Selector"
                        },
                        "steps": {
                          "format": "uint32",
                          "minimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "steps",
                        "of"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "shrink"
                  ],
                  "type": "object"
                }
              ]
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "save_as": {
              "description": "Store the result as a group with this name (one undoable step).",
              "type": [
                "string",
                "null"
              ]
            },
            "select": {
              "$ref": "#/$defs/Selector",
              "description": "Elements by meaning: `{\"faces\": {\"group\": \"top\"}}`, `{\"faces\": {\"normal\": {\"dir\": [0, 1, 0], \"within_deg\": 10}}}`,\n`{\"edges\": {\"boundary\": true}}`, `{\"verts\": {\"in_box\": {\"min\": [..], \"max\": [..]}}}`, `and`, `or`, `not`, `grow`."
            },
            "target": {
              "description": "Mesh object (name, path or id).",
              "type": "string"
            }
          },
          "required": [
            "target",
            "select"
          ],
          "title": "QueryArgs",
          "type": "object"
        },
        "name": "query"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "description": "Topology metrics per part: counts, face kinds, poles, angles, holes, pieces, degenerate elements, volume.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "target": {
              "description": "Object to measure with its children; the whole scene when omitted.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "title": "AnalyzeArgs",
          "type": "object"
        },
        "name": "analyze"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": false
        },
        "description": "Optional pictures to confirm what text already says: views tiled into one PNG with part names drawn on.",
        "inputSchema": {
          "$defs": {
            "RenderMode": {
              "description": "How surfaces look.",
              "oneOf": [
                {
                  "const": "shaded",
                  "description": "Lit, one color per part; inside-out faces show red.",
                  "type": "string"
                },
                {
                  "const": "wire",
                  "description": "Hidden-line wireframe of the polygon edges.",
                  "type": "string"
                },
                {
                  "const": "shaded_wire",
                  "description": "Shaded with polygon edges.",
                  "type": "string"
                },
                {
                  "const": "matcap",
                  "description": "Gray clay: reads form and smoothness.",
                  "type": "string"
                }
              ]
            },
            "RenderView": {
              "description": "A camera view.",
              "oneOf": [
                {
                  "enum": [
                    "back",
                    "left",
                    "bottom"
                  ],
                  "type": "string"
                },
                {
                  "const": "front",
                  "description": "From +Z (the asset's front).",
                  "type": "string"
                },
                {
                  "const": "right",
                  "description": "From +X.",
                  "type": "string"
                },
                {
                  "const": "top",
                  "description": "From above, front at the bottom.",
                  "type": "string"
                },
                {
                  "const": "three_quarter",
                  "description": "From the front, right and above.",
                  "type": "string"
                }
              ]
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "labels": {
              "description": "Draw part names next to the parts (default true).",
              "type": [
                "boolean",
                "null"
              ]
            },
            "mode": {
              "$ref": "#/$defs/RenderMode",
              "default": "shaded",
              "description": "`shaded` (default), `wire`, `shaded_wire` or `matcap`."
            },
            "sheet": {
              "description": "One contact sheet image instead of one image per view (default true).",
              "type": [
                "boolean",
                "null"
              ]
            },
            "size": {
              "description": "Pixels per view side, 64 to 2048 (default 512).",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "target": {
              "description": "Object with its children; the whole scene when omitted.",
              "type": [
                "string",
                "null"
              ]
            },
            "views": {
              "description": "Views (default front, right, top, three_quarter).",
              "items": {
                "$ref": "#/$defs/RenderView"
              },
              "type": [
                "array",
                "null"
              ]
            }
          },
          "title": "RenderArgs",
          "type": "object"
        },
        "name": "render"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "description": "List ops with one-line summaries; search matches ids, labels, summaries and Blender or Maya names.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "category": {
              "description": "Only this category: scene, prim, select, edit, expect.",
              "type": [
                "string",
                "null"
              ]
            },
            "search": {
              "description": "Words to find in ids, labels, aliases (Blender and Maya names) and summaries.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "title": "ListOpsArgs",
          "type": "object"
        },
        "name": "list_ops"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "description": "One op in full: what it does, parameters with schema and defaults, examples, aliases.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "op": {
              "description": "Op id or alias, for example `prim.box` or `cube`.",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "title": "DescribeOpArgs",
          "type": "object"
        },
        "name": "describe_op"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": false
        },
        "description": "Undo, redo, checkpoints, revert and diffs between states.",
        "inputSchema": {
          "$defs": {
            "BisectTest": {
              "description": "What `history bisect` looks for.",
              "oneOf": [
                {
                  "additionalProperties": false,
                  "description": "An expectation failing, by name: `{\"expect\": \"E2\"}`.",
                  "properties": {
                    "expect": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "expect"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "A diagnostics finding: `{\"finding\": {\"code\": \"PENETRATION\", \"part\": \"ear_l\"}}`.",
                  "properties": {
                    "finding": {
                      "additionalProperties": false,
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "part": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "finding"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "A brief item failing: `{\"brief\": {\"name\": \"elf\", \"item\": \"ear length\"}}`.",
                  "properties": {
                    "brief": {
                      "additionalProperties": false,
                      "properties": {
                        "item": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "item"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "brief"
                  ],
                  "type": "object"
                }
              ]
            },
            "HistoryAction": {
              "oneOf": [
                {
                  "enum": [
                    "undo",
                    "redo"
                  ],
                  "type": "string"
                },
                {
                  "const": "list",
                  "description": "Undo transactions and checkpoints.",
                  "type": "string"
                },
                {
                  "const": "checkpoint",
                  "description": "Name the current state.",
                  "type": "string"
                },
                {
                  "const": "revert",
                  "description": "Return to a checkpoint (undoable).",
                  "type": "string"
                },
                {
                  "const": "diff",
                  "description": "What changed between two states (`from`, `to`).",
                  "type": "string"
                },
                {
                  "const": "bisect",
                  "description": "Find the transaction that made `test` fail (binary search over the history).",
                  "type": "string"
                }
              ]
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "action": {
              "$ref": "#/$defs/HistoryAction",
              "default": "list",
              "description": "`list` (default), `undo`, `redo`, `checkpoint`, `revert`, `diff` or `bisect`."
            },
            "from": {
              "description": "`diff` base: a revision number or a checkpoint name; the previous revision by default.",
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "description": "Checkpoint name for `checkpoint` and `revert`.",
              "type": [
                "string",
                "null"
              ]
            },
            "steps": {
              "description": "Steps for `undo` and `redo` (default 1).",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "target": {
              "description": "`diff` only this object and its children.",
              "type": [
                "string",
                "null"
              ]
            },
            "test": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BisectTest"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`bisect`: the test that fails now."
            },
            "to": {
              "description": "`diff` end: a revision number or a checkpoint name; the current state by default.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "title": "HistoryArgs",
          "type": "object"
        },
        "name": "history"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": false
        },
        "description": "Bring a glTF, GLB, OBJ or FBX file into the scene in meters with +Y up, repairing its meshes; the path must be inside the allowed folders.",
        "inputSchema": {
          "$defs": {
            "Length": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*(mm|cm|dm|m|km|in|ft)?\\s*$",
                  "type": "string"
                }
              ],
              "description": "Length: meters as a number, or a string with a unit (mm, cm, dm, m, km, in, ft), e.g. \"30cm\"."
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "description": "Parameters of `io.import`.",
          "properties": {
            "name": {
              "description": "Name of the object that holds the file's contents. Default: the file's single top object keeps its name; several get a parent named after the file.",
              "type": [
                "string",
                "null"
              ]
            },
            "parent": {
              "description": "Parent object for the import.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "File to read: `.glb`, `.gltf`, `.fbx` or `.obj`, inside the allowed folders. Relative paths start in the project folder.",
              "type": "string"
            },
            "weld": {
              "$ref": "#/$defs/Length",
              "default": 0.0,
              "description": "Vertices closer than this weld while repairing the meshes; 0 (default) welds identical positions only."
            }
          },
          "required": [
            "path"
          ],
          "title": "ImportParams",
          "type": "object"
        },
        "name": "import"
      },
      {
        "annotations": {
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "description": "Read the guides: quickstart, modeling, debugging and the op reference.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "topic": {
              "description": "Guide name (`quickstart`, `modeling`, `debugging`, ...); the index when omitted.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "title": "DocsArgs",
          "type": "object"
        },
        "name": "docs"
      }
    ]
  }
}
